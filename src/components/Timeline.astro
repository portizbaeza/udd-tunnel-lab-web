---
// Línea del tiempo vertical. Los hitos se editan en src/data/avances.ts.
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import { HITOS } from "../data/avances";

const imagenes = import.meta.glob<{ default: ImageMetadata }>("../assets/**/*.{jpg,jpeg,png,webp}", { eager: true });
const buscar = (ruta: string) => {
  const mod = imagenes[`../assets/${ruta.replace(/^\/+/, "")}`];
  if (!mod) console.warn(`[avances] No se encontró src/assets/${ruta}`);
  return mod?.default ?? null;
};

const hitos = await Promise.all(
  HITOS.map(async (h) => {
    const img = h.imagen ? buscar(h.imagen) : null;
    return {
      ...h,
      estado: h.estado ?? "hecho",
      img,
      full: img ? (await getImage({ src: img, width: 1600, format: "webp" })).src : null,
    };
  }),
);
const etiquetaEstado = { "hecho": null, "en-curso": "En curso", "proximo": "Próximo" } as const;
---
<ol class="tl">
  {hitos.map((h) => (
    <li class={`tl-item tl-${h.estado} reveal`}>
      <span class="tl-mark" aria-hidden="true"></span>
      <article class="tl-card">
        <div class="tl-meta">
          <time class="tl-fecha">{h.fecha}</time>
          {etiquetaEstado[h.estado] && <span class="tl-estado">{etiquetaEstado[h.estado]}</span>}
        </div>
        <h3 class="tl-titulo">{h.titulo}</h3>
        <p class="tl-desc">{h.descripcion}</p>
        {h.enlace && <a class="link-arrow tl-link" href={h.enlace.href}>{h.enlace.texto} <span aria-hidden="true">→</span></a>}
        {h.img && (
          <button type="button" class="tl-photo bn" data-lb-group="avances" data-lb-src={h.full} data-lb-title={h.titulo}>
            <Image src={h.img} alt={h.alt ?? h.titulo} widths={[360, 560]} sizes="(max-width: 760px) 86vw, 480px" loading="lazy" />
          </button>
        )}
      </article>
    </li>
  ))}
</ol>

<style>
  .tl { --line: 4px; --mark: 20px; list-style: none; margin: 0; padding: 0; position: relative; }
  .tl::before {
    content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: var(--line);
    background: var(--azul); transform: translateX(-50%);
  }
  .tl-item { position: relative; width: 50%; padding: 0 48px 48px 0; }
  .tl-item:nth-child(even) { margin-left: 50%; padding: 0 0 48px 48px; }
  .tl-item:last-child { padding-bottom: 0; }
  /* Escalonado: tras una tarjeta con foto, la siguiente sube para no dejar huecos grandes. */
  @media (min-width: 761px) {
    .tl-item:has(.tl-photo) + .tl-item { margin-top: -200px; }
  }

  .tl-mark {
    position: absolute; top: 22px; right: calc(var(--mark) / -2); width: var(--mark); height: var(--mark);
    background: var(--naranjo); border: 4px solid var(--naranjo);
  }
  .tl-item:nth-child(even) .tl-mark { right: auto; left: calc(var(--mark) / -2); }
  .tl-en-curso .tl-mark { background: var(--blanco); }
  .tl-proximo .tl-mark { background: var(--blanco); border-color: var(--azul); }

  .tl-card { background: var(--gris-niebla); padding: 24px; display: grid; gap: 12px; }
  .tl-en-curso .tl-card { border-left: 6px solid var(--naranjo); }
  .tl-proximo .tl-card { background: var(--blanco); border: 2px solid var(--gris-claro); }
  .tl-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .tl-fecha { font-weight: 800; font-size: 14px; letter-spacing: .14em; text-transform: uppercase; color: var(--azul); }
  .tl-estado {
    font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    background: var(--azul); color: var(--blanco); padding: 3px 8px;
  }
  .tl-titulo { font-family: var(--font-display); text-transform: uppercase; font-size: clamp(1.25rem, 2.2vw, 1.65rem); line-height: 1.08; color: var(--azul); }
  .tl-desc { color: var(--texto); }
  .tl-link { justify-self: start; font-size: 15px; }
  .tl-photo { display: block; width: 100%; padding: 0; border: 0; background: var(--gris-claro); overflow: hidden; margin-top: 4px; }
  .tl-photo :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }

  /* Celular: línea a la izquierda, tarjetas a la derecha */
  @media (max-width: 760px) {
    .tl::before { left: 9px; transform: none; }
    .tl-item, .tl-item:nth-child(even) { width: 100%; margin-left: 0; padding: 0 0 32px 44px; }
    .tl-mark, .tl-item:nth-child(even) .tl-mark { left: 1px; right: auto; }
    .tl-card { padding: 18px; }
  }
</style>

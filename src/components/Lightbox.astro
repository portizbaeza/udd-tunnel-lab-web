---
// Visor de fotos compartido. Cualquier botón con data-lb-group, data-lb-src y data-lb-title
// lo abre; recorre solo las fotos de su mismo grupo que estén visibles.
---
<dialog class="lightbox" data-lightbox aria-label="Visor de fotos">
  <div class="lb-head">
    <span class="lb-num" data-lb-num></span>
    <button type="button" class="lb-close" data-lb-close>Cerrar <span aria-hidden="true">✕</span></button>
  </div>
  <figure class="lb-stage">
    <img data-lb-img alt="" />
    <figcaption class="lb-title" data-lb-caption></figcaption>
  </figure>
  <div class="lb-foot">
    <span class="lb-pos" data-lb-pos></span>
    <div class="lb-nav">
      <button type="button" class="lb-btn" data-lb-prev aria-label="Foto anterior">←</button>
      <button type="button" class="lb-btn" data-lb-next aria-label="Foto siguiente">→</button>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; background: var(--negro); color: var(--blanco);
    display: none; flex-direction: column;
  }
  .lightbox[open] { display: flex; }
  .lb-head, .lb-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px var(--gutter); }
  .lb-num { font-family: var(--font-display); font-size: 20px; color: var(--naranjo); }
  .lb-close, .lb-btn {
    min-height: 48px; min-width: 48px; padding: 8px 16px; background: transparent; color: var(--blanco);
    border: 2px solid var(--gris-acero); font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  }
  .lb-close:hover, .lb-btn:hover { border-color: var(--naranjo); color: var(--naranjo); }
  .lb-btn { font-size: 20px; }
  .lb-nav { display: flex; gap: 8px; }
  .lb-pos { font-weight: 700; color: var(--gris-claro); }
  .lb-stage { flex: 1; margin: 0; min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 12px; padding-inline: var(--gutter); }
  .lb-stage img { width: 100%; height: 100%; object-fit: contain; }
  .lb-title { font-size: 18px; font-weight: 600; text-align: center; }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const cap = dlg.querySelector<HTMLElement>("[data-lb-caption]")!;
    const num = dlg.querySelector<HTMLElement>("[data-lb-num]")!;
    const pos = dlg.querySelector<HTMLElement>("[data-lb-pos]")!;
    let items: HTMLElement[] = [];
    let i = 0;

    const render = () => {
      const it = items[i];
      img.src = it.dataset.lbSrc!;
      img.alt = it.dataset.lbTitle ?? "";
      cap.textContent = it.dataset.lbTitle ?? "";
      num.textContent = `Registro ${String(i + 1).padStart(2, "0")}`;
      pos.textContent = `${i + 1} / ${items.length}`;
    };
    const step = (d: number) => { i = (i + d + items.length) % items.length; render(); };

    document.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-lb-src]");
      if (!t) return;
      const group = t.dataset.lbGroup;
      items = [...document.querySelectorAll<HTMLElement>(`[data-lb-src][data-lb-group="${group}"]`)]
        .filter((el) => el.offsetParent !== null || el === t);
      i = Math.max(0, items.indexOf(t));
      render();
      dlg.showModal();
    });
    dlg.querySelector("[data-lb-close]")!.addEventListener("click", () => dlg.close());
    dlg.querySelector("[data-lb-prev]")!.addEventListener("click", () => step(-1));
    dlg.querySelector("[data-lb-next]")!.addEventListener("click", () => step(1));
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") step(1);
      if (e.key === "ArrowLeft") step(-1);
    });
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>

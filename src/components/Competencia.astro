---
// Competencia en el inicio: una idea, dos líneas y las tres fases como elemento visual.
// El detalle (qué tiene que lograr la máquina, qué queremos demostrar) está en /propuesta#competencia.
const fases = ["Diseñar", "Fabricar", "Competir"];
---
<section id="competencia" class="section competencia" aria-labelledby="competencia-title">
  <div class="container">
    <div class="comp-head reveal">
      <span class="kicker">La competencia</span>
      <h2 id="competencia-title" class="h2">Excavar más rápido que un caracol</h2>
      <p class="lead">La Not-a-Boring Competition, de The Boring Company, desafía a universidades de todo el mundo a hacer túneles más rápidos, seguros y baratos. La meta: superar a un caracol.</p>
      <a class="link-arrow" href="/propuesta#competencia">Qué exige la competencia <span aria-hidden="true">→</span></a>
    </div>

    <ol class="phases reveal" aria-label="Fases del proyecto">
      {fases.map((f, i) => (
        <li class="phase">
          <span class="phase-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="phase-name">{f}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .competencia .h2 { color: var(--azul); }
  .comp-head { display: grid; gap: 24px; justify-items: start; }

  .phases { list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .phase {
    position: relative; overflow: hidden; min-height: 200px; padding: 28px;
    display: flex; align-items: flex-end; background: var(--azul); color: var(--blanco);
  }
  .phase:nth-child(2) { background: var(--naranjo); color: var(--azul); }
  .phase-name { position: relative; font-family: var(--font-display); text-transform: uppercase; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1; }
  .phase-num {
    position: absolute; right: -6px; top: -18px; font-family: var(--font-display); font-size: 8rem; line-height: 1;
    color: var(--azul-intenso); transform: scaleX(1.35); transform-origin: right top; pointer-events: none;
  }
  .phase:nth-child(2) .phase-num { color: var(--naranjo-claro); }

  @media (max-width: 760px) {
    .phases { grid-template-columns: 1fr; }
    .phase { min-height: 120px; }
  }
</style>

---
import { Image } from "astro:assets";
import logoNegativo from "../assets/brand/logo-negativo.png";
import uddBlanco from "../assets/brand/udd-blanco.png";
import sudamerica from "../assets/brand/sudamerica-naranjo.png";
import ChileFlag from "./ChileFlag.astro";
import SocialIcon from "./SocialIcon.astro";
import { SITE, NAV_LINKS, REDES } from "../config/site";

interface Props { note?: string }
const { note = "Facultad de Ingeniería UDD · Chile" } = Astro.props;
---
<footer class="footer bg-negro">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="Ir al inicio"><Image src={logoNegativo} alt="B.I.C.H.O by Tunnel Lab" width={260} class="f-logo" /></a>
      <span class="f-sep" aria-hidden="true"></span>
      <Image src={uddBlanco} alt="Universidad del Desarrollo" width={140} class="f-udd" />
    </div>
    <div class="footer-flags">
      <ChileFlag width={34} />
      <Image src={sudamerica} alt="" width={24} class="f-sa" />
      <span>{note}</span>
    </div>
    <a class="footer-back" href="#contenido">Volver arriba ↑</a>
  </div>
  <div class="container footer-nav">
    <nav aria-label="Pie de página">
      <ul>
        {[{ href: "/", label: "Inicio" }, ...NAV_LINKS, { href: "/#apoya", label: "Apoyar" }].map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-contact">
      <a href={`mailto:${SITE.correoEquipo}`}>{SITE.correoEquipo}</a>
      <ul class="footer-redes" aria-label="Redes sociales">
        {REDES.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener" aria-label={`${r.nombre} ${r.usuario} (se abre en una pestaña nueva)`}>
              <SocialIcon red={r.red} size={26} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container footer-legal">
    <span>© {new Date().getFullYear()} UDD Tunnel Lab · Universidad del Desarrollo</span>
    <span>Proyecto independiente, no patrocinado ni respaldado por The Boring Company.</span>
  </div>
</footer>

<style>
  .footer { padding-block: 56px 32px; }
  .footer-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .footer-brand { display: flex; align-items: center; gap: 18px; }
  .footer-brand :global(.f-logo) { width: 200px; height: auto; }
  .footer-brand :global(.f-udd) { width: 100px; height: auto; }
  .f-sep { width: 1px; height: 36px; background: var(--gris-acero); }
  .footer-flags { display: flex; align-items: center; gap: 14px; font-weight: 600; color: var(--gris-claro); }
  .footer-flags :global(.f-sa) { width: 22px; height: auto; }
  .footer-back { font-weight: 800; text-transform: uppercase; letter-spacing: .06em; text-decoration: none; border-bottom: 3px solid var(--naranjo); padding-bottom: 4px; }
  .footer-back:hover { color: var(--naranjo); }
  .footer-nav { margin-top: 36px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 32px; }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .footer-nav a, .footer-contact > a { display: inline-block; padding-block: 8px; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: .04em; }
  .footer-contact > a { text-transform: none; letter-spacing: 0; }
  .footer-nav a:hover, .footer-contact a:hover { color: var(--naranjo); }
  .footer-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; }
  .footer-nav .footer-redes { gap: 8px; }
  .footer-redes a { display: grid; place-items: center; width: 44px; height: 44px; color: var(--blanco); }
  .footer-legal {
    margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--azul);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: 15px; color: var(--gris-acero);
  }
</style>

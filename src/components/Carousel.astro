---
import { Image, getImage } from "astro:assets";
import { getFotos } from "../lib/galeria";
import reunion06 from "../assets/bitacora/reunion-06.jpg";

const destacadas = [
  { img: reunion06, titulo: "El equipo completo en la primera reunión general" },
  ...getFotos().filter((f) => f.carrusel).map((f) => ({ img: f.img, titulo: f.titulo })),
];
const items = await Promise.all(
  destacadas.map(async (f) => ({ ...f, full: (await getImage({ src: f.img, width: 1600, format: "webp" })).src })),
);
---
<section class="registro" aria-labelledby="registro-title">
  <div class="container">
    <div class="registro-head">
      <div>
        <h2 id="registro-title" class="kicker">Registro del equipo</h2>
        <p class="registro-meta">Primera reunión general · <strong>Ago 2026 · Sala Maker Campus UDD</strong></p>
      </div>
      <div class="registro-controls">
        <span class="registro-pos" data-car-pos aria-live="polite"></span>
        <button type="button" class="car-btn" data-car-prev aria-label="Fotos anteriores">←</button>
        <button type="button" class="car-btn" data-car-next aria-label="Fotos siguientes">→</button>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="car-viewport">
      <ul class="car-track" data-car-track>
        {items.map((f, i) => (
          <li class="car-item">
            <button type="button" class="car-card bn" data-lb-group="registro" data-lb-src={f.full} data-lb-title={f.titulo}>
              <span class="car-frame">
                <Image src={f.img} alt={f.titulo} widths={[360, 560, 800]} sizes="(max-width: 560px) 90vw, (max-width: 900px) 45vw, 300px" loading="lazy" />
                <span class="car-num">{String(i + 1).padStart(2, "0")}</span>
              </span>
              <span class="car-title">{f.titulo}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .registro { padding-block: 48px 64px; background: var(--blanco); }
  .registro-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .registro-meta { margin-top: 6px; color: var(--texto); }
  .registro-meta strong { color: var(--azul); }
  .registro-controls { display: flex; align-items: center; gap: 8px; }
  .registro-pos { font-weight: 700; color: var(--texto); margin-right: 8px; font-variant-numeric: tabular-nums; }
  .car-btn {
    width: 52px; height: 52px; background: var(--azul); color: var(--blanco); border: 0; font-size: 20px;
  }
  .car-btn:hover:not(:disabled) { background: var(--naranjo); color: var(--azul); }
  .car-btn:disabled { background: var(--gris-claro); color: var(--gris-acero); cursor: default; }

  .car-viewport { overflow: hidden; }
  .car-track { --visible: 4; list-style: none; margin: 0; padding: 0; display: flex; transition: transform .45s ease; }
  .car-item { flex: 0 0 calc(100% / var(--visible)); padding-right: 12px; }
  .car-card { display: block; width: 100%; padding: 0; border: 0; background: none; text-align: left; }
  .car-frame { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--gris-niebla); }
  .car-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .car-num {
    position: absolute; left: 0; bottom: 0; padding: 4px 10px; background: var(--azul); color: var(--blanco);
    font-family: var(--font-display); font-size: 16px;
  }
  .car-title { display: block; margin-top: 10px; font-weight: 600; color: var(--texto); line-height: 1.35; }
  .car-card:hover .car-title { color: var(--azul); }

  @media (max-width: 900px) { .car-track { --visible: 2; } }
  @media (max-width: 560px) { .car-track { --visible: 1; } }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-car-track]");
  if (track) {
    const prev = document.querySelector<HTMLButtonElement>("[data-car-prev]")!;
    const next = document.querySelector<HTMLButtonElement>("[data-car-next]")!;
    const pos = document.querySelector<HTMLElement>("[data-car-pos]")!;
    const total = track.children.length;
    let index = 0;
    const visible = () => parseInt(getComputedStyle(track).getPropertyValue("--visible")) || 1;
    const render = () => {
      const v = visible();
      const max = Math.max(0, total - v);
      index = Math.min(index, max);
      track.style.transform = `translateX(-${(index * 100) / v}%)`;
      pos.textContent = `${index + 1}–${Math.min(total, index + v)} / ${total}`;
      prev.disabled = index === 0;
      next.disabled = index === max;
      [...track.children].forEach((li, k) => {
        const hidden = k < index || k >= index + v;
        li.toggleAttribute("inert", hidden);
      });
    };
    prev.addEventListener("click", () => { index = Math.max(0, index - 1); render(); });
    next.addEventListener("click", () => { index += 1; render(); });
    let raf = 0;
    window.addEventListener("resize", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(render); });
    render();
  }
</script>

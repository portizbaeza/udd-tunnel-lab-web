---
import { HERO_VIDEO } from "../config/videos";
import { SITE } from "../config/site";
import ChileFlag from "./ChileFlag.astro";
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={HERO_VIDEO.poster} data-hero-video>
      <source src={HERO_VIDEO.webm} type="video/webm" />
      <source src={HERO_VIDEO.mp4} type="video/mp4" />
    </video>
    <div class="hero-veil"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-eyebrow">
      <span class="tag-bar">Facultad de Ingeniería · Universidad del Desarrollo</span>
      <span class="hero-flag"><ChileFlag width={30} /> Chile</span>
    </div>

    <h1 id="hero-title" class="h1">Construimos la primera tuneladora <span class="accent">sudamericana</span> para competir en Texas</h1>

    <div class="hero-lead-grid">
      <p class="hero-lead">Somos <strong>UDD Tunnel Lab</strong>: {SITE.totalEquipo} estudiantes y profesores de la Universidad del Desarrollo en la <strong>Not-a-Boring Competition</strong> de Bastrop, Texas.</p>
      <p class="hero-note">Hoy: diseño preliminar en curso.</p>
    </div>

    <div class="hero-actions">
      <a class="btn btn-naranjo" href="#propuesta">Conoce el proyecto</a>
      <a class="btn btn-borde" href="#socios">Apoya como empresa</a>
    </div>
  </div>

  <div class="hero-bottom">
    <div class="container hero-bottom-inner">
      <div class="countdown" role="group" aria-label="Cuenta atrás hasta la entrega en Texas">
        <div class="countdown-label">
          <strong>Entrega en Texas</strong>
          <span>Feb 2027 · Bastrop, TX</span>
        </div>
        <div class="countdown-units" data-deadline={SITE.deadline}>
          <div class="unit"><span class="value" data-cd="d">—</span><span class="label">días</span></div>
          <div class="unit"><span class="value" data-cd="h">—</span><span class="label">horas</span></div>
          <div class="unit"><span class="value" data-cd="m">—</span><span class="label">min</span></div>
          <div class="unit"><span class="value" data-cd="s">—</span><span class="label">seg</span></div>
        </div>
      </div>
      <button type="button" class="video-toggle" data-video-toggle aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="i-pause"><rect x="2" y="1" width="3.5" height="12" fill="currentColor"/><rect x="8.5" y="1" width="3.5" height="12" fill="currentColor"/></svg>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="i-play"><path d="M3 1l10 6-10 6z" fill="currentColor"/></svg>
        <span data-video-toggle-label>Pausar video</span>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; color: var(--blanco); background: var(--azul);
    min-height: calc(100svh - var(--nav-h)); display: flex; flex-direction: column; justify-content: flex-end;
    overflow: hidden;
  }
  .hero-media { position: absolute; inset: 0; z-index: -1; }
  .hero-video { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); }
  /* Velo plano azul marino (sin degradado) para asegurar contraste del texto */
  .hero-veil { position: absolute; inset: 0; background: rgb(1 13 99 / .66); }

  .hero-inner { padding-block: clamp(40px, 7vh, 96px) 36px; display: grid; gap: 24px; }
  .hero-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .hero .tag-bar { background: var(--naranjo); color: var(--azul); }
  .hero-flag { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; font-size: 15px; }
  .hero .h1 { font-size: clamp(2.2rem, 5vw, 4.8rem); max-width: 18ch; }
  .hero-lead-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 32px 48px; align-items: end; max-width: 1080px; }
  .hero-lead { font-size: clamp(1.1rem, 1.7vw, 1.4rem); line-height: 1.5; }
  .hero-note { font-weight: 600; color: var(--gris-claro); border-left: 3px solid var(--naranjo); padding-left: 16px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }

  .hero-bottom { background: var(--azul); border-top: 4px solid var(--naranjo); }
  .hero-bottom-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-block: 20px; }
  .countdown { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 40px; }
  .countdown-label { display: grid; gap: 2px; }
  .countdown-label strong { font-family: var(--font-display); font-weight: 400; font-size: 22px; text-transform: uppercase; }
  .countdown-label span:last-child { color: var(--gris-claro); font-weight: 600; }
  .countdown-units { display: flex; gap: 6px; }
  .unit { min-width: 78px; padding: 10px 12px; background: var(--azul-intenso); display: grid; justify-items: center; }
  .unit .value { font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .unit .label { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gris-claro); }

  .video-toggle {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 16px;
    background: transparent; border: 2px solid var(--gris-acero); color: var(--blanco);
    font-weight: 700; font-size: 14px; letter-spacing: .08em; text-transform: uppercase;
  }
  .video-toggle:hover { border-color: var(--blanco); }
  .video-toggle .i-play { display: none; }
  .video-toggle[aria-pressed="true"] .i-play { display: block; }
  .video-toggle[aria-pressed="true"] .i-pause { display: none; }

  @media (max-width: 760px) {
    .hero-lead-grid { grid-template-columns: 1fr; }
    .unit { min-width: 64px; padding: 8px; }
  }
</style>

<script>
  // Cuenta atrás
  const units = document.querySelector<HTMLElement>("[data-deadline]");
  if (units) {
    const deadline = new Date(units.dataset.deadline!).getTime();
    const el = (k: string) => units.querySelector<HTMLElement>(`[data-cd="${k}"]`)!;
    const pad = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      const s = Math.floor(Math.max(0, deadline - Date.now()) / 1000);
      el("d").textContent = String(Math.floor(s / 86400));
      el("h").textContent = pad(Math.floor(s / 3600) % 24);
      el("m").textContent = pad(Math.floor(s / 60) % 60);
      el("s").textContent = pad(s % 60);
    };
    tick();
    setInterval(tick, 1000);
  }

  // Video del hero: respeta reduced-motion / ahorro de datos y permite pausarlo.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  const label = document.querySelector<HTMLElement>("[data-video-toggle-label]");
  if (video && toggle && label) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const setPaused = (paused: boolean) => {
      toggle.setAttribute("aria-pressed", String(paused));
      label.textContent = paused ? "Reproducir video" : "Pausar video";
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || conn?.saveData) {
      video.pause();
      video.removeAttribute("autoplay");
      setPaused(true);
    }
    toggle.addEventListener("click", () => {
      if (video.paused) { video.play(); setPaused(false); }
      else { video.pause(); setPaused(true); }
    });
  }
</script>

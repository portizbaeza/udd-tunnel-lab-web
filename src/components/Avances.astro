---
import { Image, getImage } from "astro:assets";
import { SITE } from "../config/site";
import modulos from "../assets/bitacora/prototipo-modulos-ensamblados.jpg";
import bicho from "../assets/bitacora/prototipo-bicho.jpg";
import soldando from "../assets/bitacora/equipo-soldando-electronica.jpg";
import oruga from "../assets/bitacora/integrante-armando-oruga.jpg";
import selfie from "../assets/bitacora/equipo-selfie-taller.jpg";
import reunion01 from "../assets/bitacora/reunion-01.jpg";

type Estado = "done" | "current" | "blocked" | "planned";
const roadmap: { estado: Estado; etiqueta: string; titulo: string; fecha: string; texto: string }[] = [
  { estado: "done", etiqueta: "Completado", titulo: "Convocatoria", fecha: "2026 · S2", texto: `${SITE.totalEquipo} estudiantes inscritos e identidad del equipo definida.` },
  { estado: "current", etiqueta: "En curso", titulo: "Diseño preliminar", fecha: "2026 · S2", texto: "Arquitectura por subsistemas y primer boceto para los organizadores." },
  { estado: "blocked", etiqueta: "Bloqueado · falta financiamiento", titulo: "Fabricación", fecha: "2026–2027", texto: "Mecanizado, estructura y componentes. Aquí entran nuestros socios." },
  { estado: "planned", etiqueta: "Planificado", titulo: "Pruebas en terreno", fecha: "2027 · S1", texto: "Excavación controlada, navegación y validación del sistema completo." },
  { estado: "planned", etiqueta: "Planificado", titulo: "Texas", fecha: "FEB 2027", texto: "Traslado del prototipo y competencia presencial en Bastrop." },
];

const subsistemas = [
  { nombre: "Cabezal erosionador", pct: 35, foco: "Investigación de mecanismos de corte", personas: 4 },
  { nombre: "Propulsión e hidráulica", pct: 25, foco: "Dimensionamiento de empuje", personas: 5 },
  { nombre: "Extracción de material", pct: 15, foco: "Buscando asesoría de industria", personas: 3, alerta: true },
  { nombre: "Estructura y casing", pct: 30, foco: "Layout modular en evaluación", personas: 6 },
  { nombre: "Control y navegación", pct: 20, foco: "Selección de sensores e instrumentación", personas: 7 },
  { nombre: "Software y simulación", pct: 40, foco: "Telemetría y visualización de datos", personas: 5 },
];

const bitacoraBase = [
  { fecha: "2026 · AGO", tag: "#006 · Prototipo", titulo: "Primeros prototipos de tracción a escala", texto: "Construimos y probamos los primeros módulos de oruga a escala para validar el sistema de tracción antes de pasar al diseño a tamaño real.", img: modulos, alt: "Módulos de oruga del prototipo ensamblados" },
  { fecha: "2026 · AGO", tag: "#005 · Prototipo", titulo: "Nacen B.I.C.H.O y MARK-O", texto: "Los dos primeros prototipos rodantes del equipo, construidos para iterar rápido sobre el sistema de tracción antes de comprometer diseño final.", img: bicho, alt: "Prototipo de tracción a escala bautizado B.I.C.H.O" },
  { fecha: "2026 · AGO", tag: "#004 · Diseño", titulo: "Primer boceto de B.I.C.H.O en preparación", texto: "Consolidamos las propuestas de arquitectura de los equipos en un único boceto para presentar a los organizadores de la competencia.", img: soldando, alt: "Integrantes soldando electrónica en el taller" },
  { fecha: "2026 · AGO", tag: "#003 · Equipo", titulo: "Se forman los 6 frentes de trabajo", texto: "Cada subsistema queda con un equipo de estudiantes y un profesor guía. Empieza la investigación técnica en paralelo.", img: oruga, alt: "Integrante del equipo armando piezas del prototipo" },
  { fecha: "2026 · JUL", tag: "#002 · Comunidad", titulo: `${SITE.totalEquipo} estudiantes se inscriben al proyecto`, texto: `La convocatoria abierta a todas las carreras cierra con ${SITE.totalEquipo} inscritos: ingeniería, minería, geología, obras civiles, industrial e informática.`, img: selfie, alt: "Selfie grupal del equipo en el taller" },
  { fecha: "2026 · JUL", tag: "#001 · Hito", titulo: "Nace UDD Tunnel Lab", texto: "La Facultad de Ingeniería impulsa el equipo y define su identidad: UDD Tunnel Lab, con B.I.C.H.O como nombre de la máquina.", img: reunion01, alt: "Laboratorio de innovación de la UDD durante la primera reunión" },
];
const bitacora = await Promise.all(
  bitacoraBase.map(async (b) => ({ ...b, full: (await getImage({ src: b.img, width: 1600, format: "webp" })).src })),
);
---
<section id="avances" class="section avances bg-niebla" aria-labelledby="avances-title">
  <div class="container">
    <div class="av-head">
      <div class="stack-m">
        <span class="tag-bar">03 · Avances del proyecto</span>
        <h2 id="avances-title" class="h2">Todo el proyecto, a la vista.</h2>
      </div>
      <div class="tabs" role="tablist" aria-label="Vista de avances">
        <button type="button" role="tab" id="tab-roadmap" aria-controls="panel-roadmap" aria-selected="true" class="tab">Roadmap</button>
        <button type="button" role="tab" id="tab-board" aria-controls="panel-board" aria-selected="false" tabindex="-1" class="tab">Subsistemas</button>
        <button type="button" role="tab" id="tab-log" aria-controls="panel-log" aria-selected="false" tabindex="-1" class="tab">Bitácora</button>
      </div>
    </div>

    <div id="panel-roadmap" role="tabpanel" aria-labelledby="tab-roadmap" class="roadmap">
      {roadmap.map((r) => (
        <article class={`rm-item rm-${r.estado}`}>
          <span class="rm-status"><i class="dot"></i>{r.etiqueta}</span>
          <h3 class="h3">{r.titulo}</h3>
          <time>{r.fecha}</time>
          <p>{r.texto}</p>
        </article>
      ))}
    </div>

    <div id="panel-board" role="tabpanel" aria-labelledby="tab-board" class="board" hidden>
      {subsistemas.map((s) => (
        <article class="board-item">
          <div class="board-head">
            <h3>{s.nombre}</h3>
            <span class="pct">{s.pct}%</span>
          </div>
          <div class="bar" role="progressbar" aria-label={`Avance de ${s.nombre}`} aria-valuenow={s.pct} aria-valuemin="0" aria-valuemax="100">
            <span class={s.alerta ? "warn" : ""} style={`width:${s.pct}%`}></span>
          </div>
          <div class="board-foot"><span>{s.foco}</span><span>{s.personas} personas</span></div>
        </article>
      ))}
    </div>

    <div id="panel-log" role="tabpanel" aria-labelledby="tab-log" class="log" hidden>
      {bitacora.map((b) => (
        <article class="log-item">
          <div class="log-date">
            <span>{b.fecha}</span>
            <span class="log-tag">{b.tag}</span>
          </div>
          <div class="log-body">
            <h3 class="h3">{b.titulo}</h3>
            <p>{b.texto}</p>
          </div>
          <button type="button" class="log-photo bn" data-lb-group="bitacora" data-lb-src={b.full} data-lb-title={b.titulo}>
            <Image src={b.img} alt={b.alt} widths={[320, 520]} sizes="(max-width: 760px) 90vw, 260px" loading="lazy" />
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .av-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 48px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0; border: 2px solid var(--azul); }
  .tab {
    min-height: 52px; padding: 10px 22px; background: transparent; border: 0;
    font-weight: 800; font-size: 16px; letter-spacing: .06em; text-transform: uppercase; color: var(--azul);
  }
  .tab + .tab { border-left: 2px solid var(--azul); }
  .tab[aria-selected="true"] { background: var(--azul); color: var(--blanco); }
  .tab:hover:not([aria-selected="true"]) { background: var(--blanco); }

  /* Roadmap */
  .roadmap { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; border-top: 4px solid var(--azul); }
  .rm-item { padding: 24px 22px 28px 0; display: grid; gap: 10px; align-content: start; position: relative; }
  .rm-item::before { content: ""; position: absolute; top: -12px; left: 0; width: 20px; height: 20px; background: var(--azul); }
  .rm-current::before { background: var(--naranjo); }
  .rm-planned::before { background: var(--gris-niebla); border: 4px solid var(--azul); }
  .rm-blocked::before { background: var(--blanco); border: 4px solid var(--azul); }
  .rm-status { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--texto); }
  .dot { width: 9px; height: 9px; background: var(--gris-acero); flex: none; }
  .rm-done .dot { background: var(--azul); }
  .rm-current .dot { background: var(--naranjo); }
  .rm-blocked .dot { background: var(--negro); }
  .rm-item time { font-weight: 700; color: var(--azul); }
  .rm-item p { color: var(--texto); font-size: 16px; }
  .rm-current { background: var(--blanco); padding-left: 18px; }
  .rm-current::before { left: 18px; }

  /* Subsistemas */
  .board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .board-item { background: var(--blanco); padding: 24px; display: grid; gap: 14px; }
  .board-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .board-head h3 { font-weight: 800; font-size: 19px; }
  .pct { font-family: var(--font-display); font-size: 30px; }
  .bar { height: 10px; background: var(--gris-niebla); }
  .bar span { display: block; height: 100%; background: var(--azul); }
  .bar span.warn { background: var(--naranjo); }
  .board-foot { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--texto); }
  .board-foot span:last-child { font-weight: 700; white-space: nowrap; color: var(--azul); }

  /* Bitácora */
  .log { display: grid; gap: 0; border-top: 2px solid var(--azul); }
  .log-item { display: grid; grid-template-columns: 180px 1fr 260px; gap: 28px; padding: 24px 0; border-bottom: 1px solid var(--gris-acero); align-items: start; }
  .log-date { display: grid; gap: 8px; font-family: var(--font-display); font-size: 18px; }
  .log-tag { justify-self: start; font-family: var(--font-body); font-weight: 800; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; background: var(--azul); color: var(--blanco); padding: 4px 10px; }
  .log-body { display: grid; gap: 10px; }
  .log-body p { color: var(--texto); }
  .log-photo { display: block; padding: 0; border: 0; background: var(--gris-claro); overflow: hidden; }
  .log-photo :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }

  @media (max-width: 1000px) {
    .roadmap { grid-template-columns: 1fr; border-top: 0; border-left: 4px solid var(--azul); }
    .rm-item { padding: 18px 0 18px 28px; }
    .rm-item::before { top: 22px; left: -12px; }
    .rm-current { padding-left: 28px; }
    .rm-current::before { left: -12px; }
    .board { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .tabs { display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; }
    .tab { padding: 10px 6px; font-size: 14px; }
    .board { grid-template-columns: 1fr; }
    .log-item { grid-template-columns: 1fr; gap: 14px; }
    .log-date { display: flex; align-items: center; gap: 12px; }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#avances [role="tab"]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") select(tabs[(i + 1) % tabs.length], true);
      if (e.key === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length], true);
    });
  });
</script>

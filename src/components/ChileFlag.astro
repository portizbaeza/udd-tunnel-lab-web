---
// Bandera de Chile plana y rectangular (sin ondas ni brillos, según el manual).
interface Props { width?: number; label?: string }
const { width = 36, label = "Chile" } = Astro.props;
const h = Math.round(width * 2 / 3);
---
<svg width={width} height={h} viewBox="0 0 30 20" role="img" aria-label={label}>
  <rect width="30" height="20" fill="#D52B1E" />
  <rect width="30" height="10" fill="#FFFFFF" />
  <rect width="10" height="10" fill="#0039A6" />
  <polygon fill="#FFFFFF" points="5,2.2 5.9,4.2 8,4.4 6.4,5.8 6.9,7.9 5,6.8 3.1,7.9 3.6,5.8 2,4.4 4.1,4.2" />
</svg>

---
import { SITE } from "../config/site";
const beneficios = [
  { t: "Talento", d: `Contacto temprano con ${SITE.totalEquipo} estudiantes de ${SITE.disciplinas} disciplinas.` },
  { t: "Innovación", d: "Un banco de pruebas real para tecnología, componentes y software." },
  { t: "Visibilidad", d: "Presencia en la máquina, la bitácora, los hitos y el viaje a Texas." },
  { t: "Vinculación", d: "Relación directa con la Facultad de Ingeniería UDD y su ecosistema." },
];
---
<section id="socios" class="section socios bg-azul" aria-labelledby="socios-title">
  <div class="container soc-grid">
    <div class="soc-copy">
      <span class="tag-bar">05 · Socios del proyecto</span>
      <h2 id="socios-title" class="h2">No buscamos un logo en una polera. <span class="accent">Buscamos socios de ingeniería.</span></h2>
      <p class="lead">Una empresa puede financiar un subsistema completo, aportar materiales, mecanizado, software, sensores, asesoría técnica, campo de pruebas o logística hacia Texas. En cambio obtiene contacto temprano con talento, un desafío técnico real donde probar sus capacidades y presencia en un proyecto chileno con proyección internacional.</p>
      <div class="soc-actions">
        <a class="btn btn-naranjo" href="#contacto" data-motivo="socio">Quiero ser socio</a>
        <p class="soc-hint">Te respondemos con el dossier del proyecto y una propuesta de colaboración.</p>
      </div>
    </div>
    <ul class="soc-benefits">
      {beneficios.map((b, i) => (
        <li class="benefit">
          <span class="b-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="h3">{b.t}</h3>
          <p>{b.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .soc-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px 80px; align-items: start; }
  .soc-copy { display: grid; gap: 28px; }
  .soc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; }
  .soc-hint { color: var(--gris-claro); font-size: 16px; max-width: 34ch; }
  .soc-benefits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .benefit { background: var(--azul-intenso); padding: 26px 24px 28px; display: grid; gap: 10px; align-content: start; min-height: 210px; }
  .benefit:nth-child(1) { background: var(--naranjo); color: var(--azul); }
  .benefit:nth-child(1) p { color: var(--azul); }
  .benefit:nth-child(1) .b-num { color: var(--azul); }
  .b-num { font-family: var(--font-display); font-size: 18px; color: var(--naranjo-claro); }
  .benefit p { color: var(--gris-claro); font-size: 17px; }
  @media (max-width: 960px) { .soc-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .soc-benefits { grid-template-columns: 1fr; } .benefit { min-height: 0; } }
</style>

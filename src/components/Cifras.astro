---
import { Image } from "astro:assets";
import { SITE } from "../config/site";
import uddBlanco from "../assets/brand/udd-blanco.png";
import saNaranjo from "../assets/brand/sudamerica-naranjo.png";
import saBlanco from "../assets/brand/sudamerica-blanco.png";
import ChileFlag from "./ChileFlag.astro";

const frases = [
  "B.I.C.H.O · Big Intelligent Chilean Hole Opener",
  "Beat the snail",
  "Talento chileno construyendo tecnología bajo tierra",
  "Not-a-Boring Competition 2026–2027",
];
---
<div class="ticker bg-naranjo" aria-hidden="true">
  <div class="ticker-track">
    {[...frases, ...frases].map((f) => (<span>{f}<i class="sq"></i></span>))}
  </div>
</div>

<section class="stats" aria-label="El proyecto en cifras">
  <div class="container stats-grid">
    <div class="stat">
      <span class="value">{SITE.totalEquipo}</span>
      <p>estudiantes y profesores de todas las carreras</p>
    </div>
    <div class="stat">
      <span class="value">{SITE.subsistemas}</span>
      <p>subsistemas en desarrollo paralelo</p>
    </div>
    <div class="stat">
      <span class="value-row"><span class="value">1º</span><Image src={saNaranjo} alt="" width={40} class="sa" /></span>
      <p>y único equipo sudamericano en la competencia</p>
    </div>
    <div class="stat">
      <span class="value">{SITE.disciplinas}</span>
      <p>disciplinas involucradas, de geología a informática</p>
    </div>
  </div>
</section>

<section class="badges bg-azul" aria-label="Respaldo del proyecto">
  <div class="container badges-grid">
    <div class="badge">
      <Image src={uddBlanco} alt="Universidad del Desarrollo" width={140} class="b-udd" />
      <p>Proyecto oficial de la Facultad de Ingeniería de la Universidad del Desarrollo.</p>
    </div>
    <div class="badge">
      <ChileFlag width={54} />
      <p>Diseñado y fabricado en Chile, con industria y talento local.</p>
    </div>
    <div class="badge">
      <Image src={saBlanco} alt="Sudamérica" width={44} class="b-sa" />
      <p>Representando a Sudamérica en una competencia global de ingeniería.</p>
    </div>
  </div>
</section>

<style>
  .ticker { overflow: hidden; border-block: 0; }
  .ticker-track { display: flex; width: max-content; animation: ticker 38s linear infinite; }
  .ticker-track span {
    display: inline-flex; align-items: center; gap: 28px; padding: 16px 0 16px 28px; white-space: nowrap;
    font-family: var(--font-display); font-size: clamp(1rem, 1.6vw, 1.3rem); text-transform: uppercase; color: var(--azul);
  }
  .sq { display: inline-block; width: 12px; height: 12px; background: var(--azul); }
  @keyframes ticker { to { transform: translateX(-50%); } }

  .stats { padding-block: clamp(56px, 7vw, 96px); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .stat { padding: 8px 28px 8px 0; border-left: 2px solid var(--azul); padding-left: 24px; }
  .stat p { margin-top: 10px; color: var(--texto); font-size: 17px; max-width: 22ch; }
  .value { font-family: var(--font-display); font-size: clamp(3.6rem, 8vw, 6.4rem); line-height: .9; color: var(--azul); }
  .stat:first-child .value { color: var(--naranjo); }
  .value-row { display: flex; align-items: end; gap: 12px; }
  .value-row :global(.sa) { width: 36px; height: auto; margin-bottom: 8px; }

  .badges { padding-block: 40px; }
  .badges-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .badge { display: flex; align-items: center; gap: 20px; }
  .badge p { color: var(--gris-claro); font-size: 17px; }
  .badge :global(.b-udd) { width: 110px; height: auto; flex: none; }
  .badge :global(.b-sa) { width: 40px; height: auto; flex: none; }
  .badge :global(svg) { flex: none; }

  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
    .badges-grid { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 420px) {
    .stat { padding-left: 16px; padding-right: 8px; }
  }
</style>

---
import { getImage } from "astro:assets";
import logoNegativo from "../assets/brand/logo-negativo.png";
import { NAV_LINKS } from "../config/site";

interface Props {
  /** true en la portada: barra transparente con texto blanco sobre el video; al hacer scroll pasa a azul marino. */
  transparente?: boolean;
}
const { transparente = false } = Astro.props;

// El logo se usa como máscara pintada con el color del texto: blanco sobre azul, azul marino sobre blanco.
const logoMask = (await getImage({ src: logoNegativo, format: "png", width: 400 })).src;
const logoRatio = `${logoNegativo.width} / ${logoNegativo.height}`;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/$/, "") || "/") === path;
---
<header class:list={["nav", { "nav--transparente": transparente }]} data-transparente={transparente ? "" : undefined}>
  <div class="nav-inner">
    <a class="nav-brand" href="/" aria-label="B.I.C.H.O by Tunnel Lab, ir al inicio">
      <span class="nav-logo" style={`--logo: url("${logoMask}"); --logo-ratio: ${logoRatio};`}></span>
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
      <span class="sr-only">Abrir menú</span>
      <span class="bar" aria-hidden="true"></span><span class="bar" aria-hidden="true"></span><span class="bar" aria-hidden="true"></span>
    </button>

    <nav class="nav-panel" id="nav-panel" aria-label="Principal">
      <ul class="nav-links">
        {NAV_LINKS.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--azul); color: var(--blanco);
    transition: transform .25s ease, background-color .25s ease, color .25s ease;
  }
  /* Portada: fija y transparente sobre el video, con texto blanco. Al bajar pasa a azul (clase is-solid). */
  .nav--transparente { position: fixed; left: 0; right: 0; }
  .nav--transparente:not(.is-solid) { background: transparent; }
  /* Se oculta al bajar y vuelve al subir (lo controla el script de abajo). */
  .nav.is-hidden { transform: translateY(-100%); }
  .nav-inner {
    max-width: var(--max); margin-inline: auto; padding-inline: var(--gutter);
    height: var(--nav-h); display: flex; align-items: center; gap: 24px;
  }
  .nav-brand { display: flex; align-items: center; text-decoration: none; flex: none; }
  .nav-logo {
    display: block; width: 150px; aspect-ratio: var(--logo-ratio); background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat;
  }

  .nav-panel { margin-left: auto; }
  .nav-links { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
  .nav-links a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 4px 14px;
    text-decoration: none; font-weight: 700; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase;
    border-bottom: 3px solid transparent; transition: color .18s, border-color .18s;
  }
  /* Hover: subrayado naranjo (sin texto naranjo, para que se lea sobre blanco). */
  .nav-links a:hover, .nav-links a:focus-visible { border-bottom-color: var(--naranjo); }
  /* Página actual */
  .nav-links a[aria-current] { color: var(--naranjo); border-bottom-color: var(--naranjo); }

  .nav-toggle {
    display: none; margin-left: auto; width: 48px; height: 48px; background: transparent; border: 0;
    flex-direction: column; justify-content: center; align-items: center; gap: 6px;
  }
  .nav-toggle .bar { width: 26px; height: 3px; background: currentColor; transition: transform .2s, opacity .2s; }
  .nav-toggle[aria-expanded="true"] .bar:nth-of-type(1) { transform: translateY(9px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .bar:nth-of-type(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .bar:nth-of-type(3) { transform: translateY(-9px) rotate(-45deg); }

  @media (max-width: 820px) {
    .nav-toggle { display: flex; }
    .nav-panel {
      display: none; position: absolute; left: 0; right: 0; top: var(--nav-h);
      background: var(--azul); border-top: 1px solid var(--azul-intenso);
      padding: 8px var(--gutter) 24px;
    }
    .nav-panel.is-open { display: block; }
    .nav-links { flex-direction: column; gap: 0; }
    .nav-links a { display: flex; padding: 14px 0; border-bottom: 1px solid var(--azul-intenso); font-size: 18px; }
    .nav-links a[aria-current] { border-bottom-color: var(--azul-intenso); border-left: 4px solid var(--naranjo); padding-left: 12px; }
    .nav-links a:hover { border-bottom-color: var(--naranjo); }
    .nav-panel { color: var(--blanco); }
  }
  @media (max-width: 420px) {
    .nav-logo { width: 132px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".nav-toggle").forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    if (!panel) return;
    const label = toggle.querySelector(".sr-only");
    const set = (open: boolean) => {
      panel.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Cerrar menú" : "Abrir menú";
    };
    toggle.addEventListener("click", () => set(!panel.classList.contains("is-open")));
    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
  });

  // Ocultar al bajar, mostrar al subir. --nav-offset permite que otros elementos fijos (filtros) la sigan.
  const nav = document.querySelector<HTMLElement>(".nav");
  if (nav) {
    const root = document.documentElement;
    let lastY = window.scrollY;
    let ticking = false;
    const transparente = nav.hasAttribute("data-transparente");
    const update = () => {
      const y = window.scrollY;
      const menuOpen = nav.querySelector(".nav-panel.is-open") !== null;
      // Portada: fondo azul apenas se hace scroll (o con el menú abierto).
      if (transparente) nav.classList.toggle("is-solid", y > 8 || menuOpen);
      const focused = nav.contains(document.activeElement);
      const hide = y > nav.offsetHeight && y > lastY + 2 && !menuOpen && !focused;
      const show = y < lastY - 2 || y <= nav.offsetHeight || menuOpen || focused;
      if (hide) nav.classList.add("is-hidden");
      else if (show) nav.classList.remove("is-hidden");
      root.style.setProperty("--nav-offset", nav.classList.contains("is-hidden") ? "0px" : `${nav.offsetHeight}px`);
      lastY = y;
      ticking = false;
    };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    nav.addEventListener("focusin", () => nav.classList.remove("is-hidden"));
    nav.querySelector(".nav-toggle")?.addEventListener("click", () => requestAnimationFrame(update));
    update();
  }
</script>

---
// Embed liviano: muestra la miniatura y carga el reproductor de YouTube solo al hacer clic.
interface Props { id: string; titulo: string }
const { id, titulo } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class="yt" data-yt={id} data-yt-title={titulo}>
  <button type="button" class="yt-btn" aria-label={`Reproducir video: ${titulo}`}>
    <img src={thumb} alt="" loading="lazy" width="480" height="360" class="yt-thumb" />
    <span class="yt-play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 28 28"><path d="M8 4l16 10-16 10z" fill="currentColor" /></svg>
    </span>
    <span class="yt-title">{titulo}</span>
  </button>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; background: var(--negro); overflow: hidden; }
  .yt-btn { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; background: none; }
  .yt-thumb { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.06); transition: filter .3s; }
  .yt-btn:hover .yt-thumb, .yt-btn:focus-visible .yt-thumb { filter: none; }
  .yt-play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 84px; height: 84px; display: grid; place-items: center; background: var(--naranjo); color: var(--azul);
  }
  .yt-btn:hover .yt-play { background: var(--naranjo-claro); }
  .yt-title {
    position: absolute; left: 0; bottom: 0; padding: 8px 14px; background: var(--azul); color: var(--blanco);
    font-weight: 700; font-size: 15px; letter-spacing: .06em; text-transform: uppercase; text-align: left;
  }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.dataset.ytTitle ?? "Video de YouTube";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    }, { once: true });
  });
</script>

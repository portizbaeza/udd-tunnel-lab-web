---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import HeroVideo from "../components/HeroVideo.astro";
import Pionero from "../components/Pionero.astro";
import Competencia from "../components/Competencia.astro";
import Apoyo from "../components/Apoyo.astro";
import Redes from "../components/Redes.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="UDD Tunnel Lab — B.I.C.H.O."
  description="UDD Tunnel Lab: equipo de la Facultad de Ingeniería de la Universidad del Desarrollo que construye B.I.C.H.O, su microtuneladora para la Not-a-Boring Competition."
>
  <Nav slot="header" transparente />
  <HeroVideo />
  <Pionero />
  <Competencia />
  <Apoyo />
  <Redes />
  <Footer slot="footer" />
</Base>

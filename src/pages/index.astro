---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Carousel from "../components/Carousel.astro";
import Cifras from "../components/Cifras.astro";
import Competencia from "../components/Competencia.astro";
import Propuesta from "../components/Propuesta.astro";
import VideoBand from "../components/VideoBand.astro";
import Avances from "../components/Avances.astro";
import Galeria from "../components/Galeria.astro";
import Socios from "../components/Socios.astro";
import Apoyo from "../components/Apoyo.astro";
import EquipoPreview from "../components/EquipoPreview.astro";
import Unete from "../components/Unete.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";

const links = [
  { href: "#competencia", label: "Competencia" },
  { href: "#propuesta", label: "Propuesta" },
  { href: "#avances", label: "Avances" },
  { href: "#galeria", label: "Galería" },
  { href: "/equipo", label: "Equipo", external: true },
  { href: "#socios", label: "Socios" },
  { href: "#apoya", label: "Apoya" },
];
---
<Base
  title="UDD Tunnel Lab — B.I.C.H.O."
  description="UDD Tunnel Lab: equipo de la Facultad de Ingeniería de la Universidad del Desarrollo que construye B.I.C.H.O, su tuneladora para la Not-a-Boring Competition."
>
  <link slot="head" rel="preload" as="image" href="/videos/hero-poster.jpg" />
  <Nav slot="header" links={links} cta={{ href: "#unete", label: "Únete" }} />
  <Hero />
  <Carousel />
  <Cifras />
  <Competencia />
  <Propuesta />
  <VideoBand />
  <Avances />
  <Galeria />
  <Socios />
  <Apoyo />
  <EquipoPreview />
  <Unete />
  <Contacto />
  <Footer slot="footer" />
  <Lightbox />
</Base>

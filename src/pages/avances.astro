---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Timeline from "../components/Timeline.astro";
import Galeria from "../components/Galeria.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import VideoBand from "../components/VideoBand.astro";
---
<Base
  title="Avances — UDD Tunnel Lab"
  description="Línea del tiempo de UDD Tunnel Lab: primeras pruebas, hitos y galería de B.I.C.H.O."
  path="/avances"
>
  <Nav slot="header" />

  <VideoBand tituloComo="h1" />

  <section class="section" aria-label="Línea del tiempo">
    <div class="container av-tl">
      <Timeline />
    </div>
  </section>

  <Galeria />

  <Footer slot="footer" />
  <Lightbox />
</Base>

<style>
  .av-tl { max-width: 1040px; }
</style>

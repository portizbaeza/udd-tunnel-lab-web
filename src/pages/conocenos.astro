---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site";
import { getMiembros, getFrentes, getCapitanes } from "../lib/miembros";
import bichoGris from "../assets/brand/bicho-blanco.png";

const miembros = await Promise.all(
  getMiembros().map(async (m) => ({
    ...m,
    fotoGrande: m.foto ? (await getImage({ src: m.foto, width: 700, format: "webp" })).src : null,
  })),
);
const frentes = getFrentes(miembros);
const carreras = new Set(miembros.flatMap((m) => m.carreras)).size;
const capitanes = getCapitanes();
const placeholder = (await getImage({ src: bichoGris, width: 200, format: "png" })).src;
---
<Base
  title="Conócenos — UDD Tunnel Lab"
  description={`Las ${SITE.totalEquipo} personas construyendo B.I.C.H.O: el equipo interdisciplinario de UDD Tunnel Lab.`}
  path="/conocenos"
>
  <Nav slot="header" />

  <section class="eq-hero bg-azul" aria-labelledby="eq-title">
    <div class="container eq-hero-grid">
      <div class="stack-m">
        <span class="tag-bar">Conócenos</span>
        <h1 id="eq-title" class="h1">Las {SITE.totalEquipo} personas construyendo <span class="accent">B.I.C.H.O</span></h1>
      </div>
      <div class="stack-s">
        <p class="lead">Estudiantes y profesores de distintas carreras, organizados por frente de trabajo. Toca una ficha para ver más y contactar.</p>
        <p class="eq-meta">{miembros.length} fichas · {carreras} carreras · {frentes.length} frentes</p>
      </div>
    </div>
  </section>

  {capitanes.length > 0 && (
    <section id="capitanes" class="section capitanes bg-naranjo-claro" aria-labelledby="cap-title">
      <div class="container">
        <div class="cap-head reveal">
          <span class="kicker">Quienes lideran</span>
          <h2 id="cap-title" class="h2">Capitanes</h2>
        </div>
        <ul class="cap-grid">
          {capitanes.map(({ miembro: m, index, rol }) => (
            <li class="reveal">
              <button type="button" class="cap-card" data-person={index} aria-haspopup="dialog">
                <span class="cap-photo">
                  {m.foto
                    ? <Image src={m.foto} alt="" widths={[400, 640]} sizes="(max-width: 720px) 92vw, 400px" loading="lazy" />
                    : <span class="p-ph"><img src={placeholder} alt="" /></span>}
                </span>
                <span class="cap-body">
                  <span class="cap-rol">{rol}</span>
                  <span class="cap-name">{m.nombre}</span>
                  <span class="p-carrera">{m.frentes.join(" · ")}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="frentes" class="filters" aria-label="Filtrar por frente">
    <div class="container filters-row">
      <span class="kicker">Filtrar por frente</span>
      <div class="chips" role="group" aria-label="Frentes de trabajo">
        <button type="button" class="chip" data-frente="Todos" aria-pressed="true">Todos</button>
        {frentes.map((f) => <button type="button" class="chip" data-frente={f} aria-pressed="false">{f}</button>)}
      </div>
      <span class="filters-count" data-count aria-live="polite">{miembros.length} fichas</span>
    </div>
  </section>

  <section class="roster-section" aria-label="Integrantes">
    <div class="container">
      <ul class="roster">
        {miembros.map((m, i) => (
          <li class="person" data-frentes={m.frentes.join("|")}>
            <button type="button" class="person-card" data-person={i} aria-haspopup="dialog">
              <span class="p-photo">
                {m.foto
                  ? <Image src={m.foto} alt="" widths={[300, 480]} sizes="(max-width: 560px) 46vw, (max-width: 1000px) 31vw, 280px" loading="lazy" />
                  : <span class="p-ph"><img src={placeholder} alt="" /></span>}
                <span class="p-num">{m.num}</span>
              </span>
              <span class="p-body">
                <span class="p-name">{m.nombre}</span>
                <span class="p-rol">{m.frentes.join(" · ")}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />

  <dialog class="person-modal" data-person-modal aria-labelledby="pm-nombre">
    <div class="pm-card">
      <button type="button" class="pm-close" data-pm-close>Cerrar <span aria-hidden="true">✕</span></button>
      <div class="pm-photo" data-pm-photo></div>
      <div class="pm-body">
        <span class="pm-num" data-pm-num></span>
        <h2 id="pm-nombre" class="pm-nombre" data-pm-nombre></h2>
        <p class="p-carrera" data-pm-carrera></p>
        <div class="p-frentes" data-pm-frentes></div>
        <p class="pm-frase" data-pm-frase></p>
        <p class="pm-desc" data-pm-desc></p>
        <div class="pm-contact" data-pm-contact></div>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" id="miembros-data" set:html={JSON.stringify(miembros.map((m) => ({
    num: m.num, nombre: m.nombre, carreras: m.carreras, frentes: m.frentes, frase: m.frase,
    descripcion: m.descripcion, linkedin: m.linkedin, correo: m.correo, foto: m.fotoGrande,
  }))).replace(/</g, "\\u003c")} />
</Base>

<style>
  .eq-hero { padding-block: clamp(56px, 8vw, 104px); }
  .eq-hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 32px 64px; align-items: end; }
  .eq-hero .h1 { font-size: clamp(2.4rem, 6vw, 5.2rem); }
  .eq-meta { font-weight: 700; color: var(--blanco); letter-spacing: .04em; text-transform: uppercase; font-size: 15px; }

  .filters { position: sticky; top: var(--nav-offset, var(--nav-h)); transition: top .25s ease; z-index: 50; background: var(--blanco); border-bottom: 2px solid var(--azul); }
  .filters-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-block: 14px; }
  .filters-count { margin-left: auto; font-weight: 800; }

  .roster-section { padding-block: 40px 96px; }
  .roster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .person[hidden] { display: none; }
  .person-card { display: flex; flex-direction: column; width: 100%; height: 100%; padding: 0; border: 0; background: var(--gris-niebla); text-align: left; }
  .person-card:hover { background: var(--gris-claro); }
  .p-photo { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--azul); }
  .p-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .p-ph { display: grid; place-items: center; width: 100%; height: 100%; }
  .p-ph img { width: 30% !important; height: auto !important; opacity: .35; }
  .p-num { position: absolute; left: 0; bottom: 0; padding: 4px 10px; background: var(--naranjo); color: var(--azul); font-family: var(--font-display); font-size: 16px; }
  .p-body { display: grid; gap: 8px; padding: 16px 16px 20px; }
  .p-name { font-weight: 800; font-size: 19px; line-height: 1.2; color: var(--azul); }
  .p-carrera { font-size: 15px; color: var(--texto); }
  .p-frentes { display: flex; flex-wrap: wrap; gap: 4px; }
  .frente-tag, :global(.frente-tag) { display: inline-block; padding: 2px 8px; border: 1.5px solid var(--azul); font-weight: 700; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--azul); }
  .p-rol { font-weight: 700; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; color: var(--texto); }

  /* Capitanes */
  .cap-head { display: grid; gap: 16px; margin-bottom: 32px; }
  .cap-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .cap-card { display: grid; grid-template-rows: auto 1fr; width: 100%; height: 100%; padding: 0; border: 0; background: var(--azul); color: var(--blanco); text-align: left; }
  .cap-card:hover .cap-body, .cap-card:focus-visible .cap-body { background: var(--azul-intenso); }
  .cap-photo { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--azul-intenso); }
  .cap-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cap-body { display: grid; gap: 6px; padding: 18px 20px 22px; border-top: 6px solid var(--naranjo); }
  .cap-rol { font-weight: 800; font-size: 14px; letter-spacing: .14em; text-transform: uppercase; color: var(--naranjo); }
  .cap-name { font-family: var(--font-display); font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.05; text-transform: uppercase; }
  .cap-body .p-carrera { color: var(--gris-claro); font-size: 15px; }

  .person-modal { width: min(920px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); background: var(--blanco); color: var(--azul); overflow: auto; }
  .pm-card { display: grid; grid-template-columns: 340px 1fr; position: relative; }
  .pm-close { position: absolute; right: 0; top: 0; z-index: 2; min-height: 48px; padding: 8px 16px; background: var(--azul); color: var(--blanco); border: 0; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .pm-close:hover { background: var(--naranjo); color: var(--azul); }
  .pm-photo { background: var(--azul); min-height: 360px; }
  .pm-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pm-photo :global(.p-ph) { min-height: 360px; }
  .pm-body { padding: 56px 32px 32px; display: grid; gap: 12px; align-content: start; }
  .pm-num { font-family: var(--font-display); color: var(--naranjo); font-size: 18px; }
  .pm-nombre { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.05; text-transform: uppercase; }
  .pm-frase { font-weight: 700; font-size: 19px; border-left: 4px solid var(--naranjo); padding-left: 14px; }
  .pm-desc { color: var(--texto); }
  .pm-desc.is-pending { font-style: italic; color: var(--texto); }
  .pm-contact { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .pm-contact :global(a) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 14px; border: 2px solid var(--azul); font-weight: 800; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; }
  .pm-contact :global(a:hover) { background: var(--azul); color: var(--blanco); }

  @media (max-width: 1000px) { .roster { grid-template-columns: repeat(3, 1fr); } .eq-hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .roster { grid-template-columns: repeat(2, 1fr); }
    .pm-card { grid-template-columns: 1fr; }
    .pm-photo { min-height: 0; aspect-ratio: 4 / 3; }
    .filters { position: static; }
    .filters-count { margin-left: 0; }
  }
  @media (max-width: 400px) { .p-name { font-size: 17px; } .p-body { padding: 12px; } }
</style>

<script>
  interface M { num: string; nombre: string; carreras: string[]; frentes: string[]; frase: string; descripcion: string | null; linkedin: string | null; correo: string | null; foto: string | null }
  const data: M[] = JSON.parse(document.getElementById("miembros-data")!.textContent!);

  // Filtros
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-frente]");
  const people = document.querySelectorAll<HTMLElement>(".person");
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  chips.forEach((chip) => chip.addEventListener("click", () => {
    const f = chip.dataset.frente!;
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
    let n = 0;
    people.forEach((p) => {
      const show = f === "Todos" || p.dataset.frentes!.split("|").includes(f);
      p.hidden = !show;
      if (show) n++;
    });
    count.textContent = `${n} ${n === 1 ? "ficha" : "fichas"}`;
  }));

  // Ficha ampliada
  const modal = document.querySelector<HTMLDialogElement>("[data-person-modal]")!;
  const $ = (k: string) => modal.querySelector<HTMLElement>(`[data-pm-${k}]`)!;
  const text = (s: string) => { const span = document.createElement("span"); span.textContent = s; return span; };
  const icon = (d: string) => `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="${d}"/></svg>`;
  const LI = "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z";
  const MAIL = "M2 4h20v16H2V4zm2 2.24V18h16V6.24l-8 5.99-8-5.99zM4.5 6l7.5 5.63L19.5 6h-15z";
  let opener: HTMLElement | null = null;

  const open = (i: number, from: HTMLElement) => {
    const m = data[i];
    opener = from;
    const photo = $("photo");
    photo.replaceChildren();
    if (m.foto) {
      const img = document.createElement("img");
      img.src = m.foto; img.alt = m.nombre;
      photo.append(img);
    } else {
      const ph = from.querySelector(".p-ph");
      if (ph) photo.append(ph.cloneNode(true));
    }
    $("num").textContent = `Ficha ${m.num}`;
    $("nombre").textContent = m.nombre;
    $("carrera").textContent = m.carreras.join(" · ");
    $("frentes").replaceChildren(...m.frentes.map((f) => { const s = text(f); s.className = "frente-tag"; return s; }));
    $("frase").textContent = `«${m.frase}»`;
    const desc = $("desc");
    desc.textContent = m.descripcion ?? "La descripción pronto se subirá.";
    desc.classList.toggle("is-pending", !m.descripcion);
    const contact = $("contact");
    contact.replaceChildren();
    if (m.linkedin) {
      const a = document.createElement("a");
      a.href = m.linkedin; a.target = "_blank"; a.rel = "noopener";
      a.innerHTML = icon(LI); a.append(text("LinkedIn"));
      const sr = text(" (se abre en una pestaña nueva)"); sr.className = "sr-only"; a.append(sr);
      contact.append(a);
    }
    if (m.correo) {
      const a = document.createElement("a");
      a.href = `mailto:${m.correo}`;
      a.innerHTML = icon(MAIL); a.append(text(m.correo));
      contact.append(a);
    }
    modal.showModal();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-person]").forEach((b) =>
    b.addEventListener("click", () => open(Number(b.dataset.person), b)));
  modal.querySelector("[data-pm-close]")!.addEventListener("click", () => modal.close());
  modal.addEventListener("click", (e) => { if (e.target === modal) modal.close(); });
  modal.addEventListener("close", () => opener?.focus());
</script>
